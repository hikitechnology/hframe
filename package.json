{
  "name": "hframe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/hframe.umd.cjs",
  "module": "./dist/hframe.js",
  "types": "./dist/hframe.d.ts",
  "exports": {
    ".": {
      "import": "./dist/hframe.js",
      "require": "./dist/hframe.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate-barrels": "barrelsby --delete -d './lib' -n 'main.ts'"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "barrelsby": "^2.8.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vite-plugin-dts": "^4.5.3"
  }
}
